@{
    ViewData["Title"] = "Login";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card p-4 mt-5">
            <h3 class="mb-3">Sign In</h3>
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" asp-validation-summary="All"></div>
            }
            <form asp-controller="Account" asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" name="email" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" name="password" class="form-control" required />
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" name="rememberMe" class="form-check-input" value="true" />
                    <label class="form-check-label">Remember me</label>
                </div>
                <button type="submit" class="btn btn-primary w-100">Login</button>
            </form>
            <p class="mt-3 mb-0">No account? <a asp-controller="Account" asp-action="Register">Register a staff account</a></p>
            <p class="text-muted small mt-2">Default admin: admin@hms.local / Admin@12345 (change after first login)</p>
        </div>
    </div>
</div>
