@model IEnumerable<Doctor>
@{
    ViewData["Title"] = "Doctors";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Doctors</h2>
    <a class="btn btn-primary" asp-action="Create">+ Add Doctor</a>
</div>
<table class="table table-hover bg-white">
    <thead><tr><th>Name</th><th>Specialization</th><th>Department</th><th>Phone</th><th></th></tr></thead>
    <tbody>
    @foreach (var d in Model)
    {
        <tr>
            <td>@d.FullName</td>
            <td>@d.Specialization</td>
            <td>@d.Department?.Name</td>
            <td>@d.Phone</td>
            <td>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@d.Id">View</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@d.Id">Edit</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@d.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
