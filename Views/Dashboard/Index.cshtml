@{
    ViewData["Title"] = "Dashboard";
}
<h2 class="mb-4">Dashboard</h2>
<div class="row g-3">
    <div class="col-md-3">
        <div class="card p-3 text-center">
            <div class="text-muted">Total Patients</div>
            <div class="fs-2 fw-bold">@ViewBag.TotalPatients</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 text-center">
            <div class="text-muted">Total Doctors</div>
            <div class="fs-2 fw-bold">@ViewBag.TotalDoctors</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 text-center">
            <div class="text-muted">Today's Appointments</div>
            <div class="fs-2 fw-bold">@ViewBag.TodaysAppointments</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 text-center">
            <div class="text-muted">Revenue This Month</div>
            <div class="fs-2 fw-bold">@(((decimal)ViewBag.RevenueThisMonth).ToString("C"))</div>
        </div>
    </div>
</div>

<div class="row mt-4 g-3">
    <div class="col-md-4">
        <a asp-controller="Patients" asp-action="Create" class="btn btn-outline-primary w-100 py-3">+ Register Patient</a>
    </div>
    <div class="col-md-4">
        <a asp-controller="Appointments" asp-action="Create" class="btn btn-outline-primary w-100 py-3">+ Book Appointment</a>
    </div>
    <div class="col-md-4">
        <a asp-controller="Billing" asp-action="Create" class="btn btn-outline-primary w-100 py-3">+ Generate Invoice</a>
    </div>
</div>
