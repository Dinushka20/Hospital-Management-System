@model Bill
@{
    ViewData["Title"] = "Invoice Details";
}
<h2>Invoice #@Model.Id</h2>
<p class="text-muted">Patient: @Model.Patient?.FullName · Date: @Model.BillDate.ToShortDateString()</p>

<table class="table bg-white">
    <thead><tr><th>Description</th><th class="text-end">Amount</th></tr></thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr><td>@item.Description</td><td class="text-end">@item.Amount.ToString("C")</td></tr>
    }
    </tbody>
    <tfoot>
        <tr><th>Total</th><th class="text-end">@Model.TotalAmount.ToString("C")</th></tr>
        <tr><th>Paid</th><th class="text-end">@Model.AmountPaid.ToString("C")</th></tr>
        <tr><th>Balance</th><th class="text-end">@Model.Balance.ToString("C")</th></tr>
    </tfoot>
</table>

@if (Model.Balance > 0)
{
    <form asp-action="Pay" asp-route-id="@Model.Id" method="post" class="row g-2 mt-3">
        <div class="col-auto">
            <input type="number" step="0.01" name="amount" class="form-control" placeholder="Payment amount" required />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-success">Record Payment</button>
        </div>
    </form>
}
<a asp-action="Index" class="btn btn-link mt-2">Back to list</a>
