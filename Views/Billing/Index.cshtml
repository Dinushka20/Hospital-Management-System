@model IEnumerable<Bill>
@{
    ViewData["Title"] = "Billing";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Billing</h2>
    <a class="btn btn-primary" asp-action="Create">+ Generate Invoice</a>
</div>
<table class="table table-hover bg-white">
    <thead><tr><th>Date</th><th>Patient</th><th>Total</th><th>Paid</th><th>Balance</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var b in Model)
    {
        <tr>
            <td>@b.BillDate.ToShortDateString()</td>
            <td>@b.Patient?.FullName</td>
            <td>@b.TotalAmount.ToString("C")</td>
            <td>@b.AmountPaid.ToString("C")</td>
            <td>@b.Balance.ToString("C")</td>
            <td>
                <span class="badge bg-@(b.Status == BillStatus.Paid ? "success" : b.Status == BillStatus.PartiallyPaid ? "warning" : "danger")">
                    @b.Status
                </span>
            </td>
            <td><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@b.Id">View / Pay</a></td>
        </tr>
    }
    </tbody>
</table>
