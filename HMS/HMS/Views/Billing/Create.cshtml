@{
    ViewData["Title"] = "Generate Invoice";
}
<h2>Generate Invoice</h2>
<form asp-action="Create" method="post" class="row g-3 mt-2">
    <div class="col-md-6">
        <label class="form-label">Patient</label>
        <select name="patientId" asp-items="ViewBag.Patients" class="form-select" required>
            <option value="">-- Select Patient --</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Consultation Charges</label>
        <input type="number" step="0.01" name="consultationCharge" class="form-control" value="0" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Laboratory Charges</label>
        <input type="number" step="0.01" name="laboratoryCharge" class="form-control" value="0" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Pharmacy Charges</label>
        <input type="number" step="0.01" name="pharmacyCharge" class="form-control" value="0" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Admission Charges</label>
        <input type="number" step="0.01" name="admissionCharge" class="form-control" value="0" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Generate Invoice</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>
