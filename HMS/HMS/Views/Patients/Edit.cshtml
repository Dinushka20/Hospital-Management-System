@model Patient
@{
    ViewData["Title"] = "Edit Patient";
}
<h2>Edit Patient</h2>
<form asp-action="Edit" method="post" class="row g-3 mt-2">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="RegisteredOn" />
    <div class="col-md-6">
        <label class="form-label">Full Name</label>
        <input asp-for="FullName" class="form-control" required />
    </div>
    <div class="col-md-3">
        <label class="form-label">Date of Birth</label>
        <input asp-for="DateOfBirth" type="date" class="form-control" required />
    </div>
    <div class="col-md-3">
        <label class="form-label">Gender</label>
        <select asp-for="Gender" class="form-select">
            <option>Male</option>
            <option>Female</option>
            <option>Other</option>
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Phone</label>
        <input asp-for="Phone" class="form-control" />
    </div>
    <div class="col-md-4">
        <label class="form-label">Blood Group</label>
        <input asp-for="BloodGroup" class="form-control" />
    </div>
    <div class="col-md-4">
        <label class="form-label">Address</label>
        <input asp-for="Address" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>
