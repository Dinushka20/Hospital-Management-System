@model IEnumerable<Appointment>
@{
    ViewData["Title"] = "Appointments";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Appointments</h2>
    <a class="btn btn-primary" asp-action="Create">+ Book Appointment</a>
</div>
<table class="table table-hover bg-white">
    <thead><tr><th>Date</th><th>Patient</th><th>Doctor</th><th>Reason</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var a in Model)
    {
        <tr>
            <td>@a.AppointmentDate.ToString("g")</td>
            <td>@a.Patient?.FullName</td>
            <td>@a.Doctor?.FullName</td>
            <td>@a.Reason</td>
            <td>
                <span class="badge bg-@(a.Status == AppointmentStatus.Completed ? "success" : a.Status == AppointmentStatus.Cancelled ? "secondary" : "warning")">
                    @a.Status
                </span>
            </td>
            <td>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@a.Id">Edit</a>
                @if (a.Status == AppointmentStatus.Scheduled)
                {
                    <form asp-action="Cancel" asp-route-id="@a.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
